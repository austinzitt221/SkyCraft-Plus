{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      { "when": "grass", "model": { "type": "minecraft:model", "model": "minecraft:block/grass_block", "tints": [ { "type": "minecraft:grass", "temperature": 0.5, "downfall": 1.0 } ] } },
      { "when": "dirt", "model": { "type": "minecraft:model", "model": "minecraft:block/coarse_dirt" } },
      { "when": "snow", "model": { "type": "minecraft:model", "model": "minecraft:block/snow_block" } },
      { "when": "sand", "model": { "type": "minecraft:model", "model": "minecraft:block/sand" } },
      { "when": "gravel", "model": { "type": "minecraft:model", "model": "minecraft:block/gravel" } },
      { "when": "cobblestone", "model": { "type": "minecraft:model", "model": "minecraft:block/cobblestone" } },
      { "when": "wood", "model": { "type": "minecraft:model", "model": "minecraft:block/spruce_planks" } }
    ],
    "fallback": { "type": "minecraft:model", "model": "minecraft:block/stone" }
  }
}
